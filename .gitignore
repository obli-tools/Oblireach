node_modules/
dist/
!agent/dist/
# Build OUTPUTS (generated by the build, never versioned). The codec / MinGW
# runtime DLLs in agent/dist/ are build INPUTS (packed by product.wxs): kept.
agent/dist/*.exe
agent/dist/*.msi
agent/dist/*.wixpdb
agent/dist/oblireach-agent-darwin-*
agent/dist/oblireach-agent-linux-*
agent/dist/*version*.txt
desktop-app/dist/*.wixpdb
agent/bin/*.exe
agent/*.exe
client-app/*.exe
server/*.exe
!desktop-app/dist/
.build.cfg

# Stray version-tag / copy-artifact files (e.g. 1.0.3, v1.0.3, ..Obliance...txt)
[0-9]*.[0-9]*.[0-9]*
v[0-9]*.[0-9]*.[0-9]*
/..*.txt

# Sources / build trees of the codecs: only the *-prebuilt packages are inputs
/libvpx/
/libvpx-build/
/client/
# Download archive of the OpenH264 DLL (the DLL itself is the build input)
*.bz2
# Unused upstream tool shipped in the SVT-AV1 package
/svtav1-prebuilt/mingw64/bin/*.exe
# H.265/x265 codec (GPL v2 — not distributed, user-supplied only)
x265-prebuilt/
agent/dist/libx265*.dll
libx265*.dll

# Editors / OS
.DS_Store
Thumbs.db
coverage/
.vscode/
.idea/
*.tsbuildinfo

# Secrets, keys, certificates
.env
.env.*
!.env.example
*.pem
*.key
*.jks
*.keystore
*.pfx
*.p12
*.cer
*.crt
*.csr
*.spc
*.snk
id_rsa*
id_ed25519*

# Logs, dumps, backups, captures
*.log
**/*.log
*.dmp
*.bak
*.orig
*.pre-*
*.tmp
*.swp
*~
*.sqlite
*.sqlite3
*.db
*.har
*.pcap
*.csv

# ── Not part of the build: never versioned ──
# Docs, notes, local history and tooling scripts stay on the workstation.
# Local tool state, caches, scratch areas (never versioned; every hidden
# folder is also caught by ".*/" below, every *.md by "*.md")
.cache/
.local*/
# Any other hidden folder (editor/tool caches, secrets): never versioned.
.*/
# Docs / notes / planning / transcripts
/docs/
/docs-*/
doc/
*.md
!/README.md
*.markdown
*.txt
!/client-app/version.txt
*.rtf
*.docx
*.pdf
REPRISE*
HANDOFF*
NOTES*
