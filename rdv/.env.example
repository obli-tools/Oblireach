# oblireach-rdv configuration. Copy to .env and edit.

# private: operators authenticate with instance keys (and accounts if enabled).
# public:  open instance; operators need an account (or a static key); the
#          people being helped never need anything.
RDV_MODE=private
# Instance name shown by GET /v1/info and the web pages.
#RDV_NAME=Oblireach

# Public name of the server (TLS certificate, stun:/turn: URLs, links).
RDV_DOMAIN=support.example.com
# Absolute base URL of the web pages (registration links, emails). Default:
# https://RDV_DOMAIN (plus the port of RDV_LISTEN when it is not 443 and this
# process terminates TLS). Set it behind a reverse proxy if the default is wrong.
#RDV_PUBLIC_URL=https://support.example.com

# Address advertised for relay allocations. Default: the IPv4 RDV_DOMAIN
# resolves to.
#RDV_PUBLIC_IP=203.0.113.10

# TLS: acme (Let's Encrypt, TLS-ALPN-01 on 443) | files | off
#   off = plain HTTP: behind a TLS reverse proxy (see "Reverse proxy" below).
RDV_TLS=acme
#RDV_ACME_EMAIL=admin@example.com
#RDV_TLS_CERT=/certs/fullchain.pem
#RDV_TLS_KEY=/certs/privkey.pem

# Signalling listener. Ports below 1024 need cap_add NET_BIND_SERVICE (see
# docker-compose.example.yml); behind a reverse proxy use a high port on
# loopback, e.g. 127.0.0.1:8085.
#RDV_LISTEN=:443
#RDV_ADMIN_LISTEN=127.0.0.1:9100

# Data directory (account database, ACME certificates, TURN secret). Must be
# writable by uid 65532: with a bind mount, chown -R 65532:65532 <host dir>.
#RDV_DATA_DIR=/data

# STUN/TURN (udp + tcp) and the UDP range of relay allocations.
#RDV_TURN_PORT=3478
#RDV_RELAY_PORTS=49160-49999

# TURN over TLS on the signalling port (443), for networks that only allow
# HTTPS out, proxies included. On by default with RDV_TLS=acme or files;
# needs this process to terminate TLS (not RDV_TLS=off behind a proxy).
#RDV_TURNS=on
# Host and port put in the turns: URL (default: RDV_DOMAIN and the port of
# RDV_LISTEN; set 443 if 443 is redirected to another RDV_LISTEN port).
#RDV_TURNS_HOST=support.example.com
#RDV_TURNS_PORT=443

# Static operator keys: "label:secret" entries separated by commas or new
# lines. The label is shown to the person as the operator account. Required
# unless RDV_ACCOUNTS is on. Generate secrets with: openssl rand -hex 24
RDV_OPERATOR_KEYS=helpdesk:CHANGE_ME_0123456789abcdef0123456789abcdef
#RDV_OPERATOR_KEYS_FILE=/run/secrets/rdv_operator_keys

# ---- Operator accounts --------------------------------------------------
# Registration pages (/register), login API for Oblireach Desktop
# (/v1/account/*), SQLite database RDV_DATA_DIR/accounts.db.
# Default: on with RDV_MODE=public, off with private.
#RDV_ACCOUNTS=true

# Email verification (strongly recommended on a public instance). Without
# RDV_SMTP_HOST, new accounts are active at once and the people being helped
# see the operator's address marked "(unverified)".
#RDV_SMTP_HOST=smtp.example.com
#RDV_SMTP_PORT=587
# TLS: starttls (port 587) | tls (port 465) | none (local relay only)
#RDV_SMTP_TLS=starttls
#RDV_SMTP_USER=rdv@example.com
#RDV_SMTP_PASSWORD=
#RDV_SMTP_FROM=Oblireach <noreply@example.com>

# Account quotas (0 = unlimited). Defaults: 3 / 50 / 20 on a public
# instance, unlimited on a private one. Static keys have no quota.
# Sessions at once, sessions per UTC day, relayed GB per UTC month (both
# directions).
#RDV_ACCOUNT_MAX_SESSIONS=3
#RDV_ACCOUNT_SESSIONS_DAY=50
#RDV_ACCOUNT_RELAY_GB_MONTH=20

# ---- Web console: admin (/admin) and operator area (/account) -------------
# Signed in at /login (browser session, separate from the Desktop logins).
# Addresses that are always admins once VERIFIED (an unverified account is
# never promoted: without SMTP anyone could register the address first; use
# "admin create" below). Comma separated.
#RDV_ADMIN_EMAILS=owner@example.com
# Admins must enrol TOTP (authenticator app) before the admin pages.
#RDV_ADMIN_REQUIRE_TOTP=true
# History kept for the pages (sign-ins, sessions), in days; then purged.
#RDV_HISTORY_DAYS=90
# Audit log of admin actions, in days.
#RDV_AUDIT_DAYS=365
# Secret of the web side (form stamps, sign-in tickets, TOTP secrets sealed
# at rest). Default: generated once and kept in RDV_DATA_DIR/web-secret.
# Losing it makes enrolled TOTP unreadable (reset with "account reset-2fa").
#RDV_WEB_SECRET=

# First admin without SMTP (prints a one-time password link, valid 1 hour):
#   docker compose exec rdv /oblireach-rdv admin create owner@example.com "Display Name"
# Admin CLI (inside the container):
#   docker compose exec rdv /oblireach-rdv account list
#   docker compose exec rdv /oblireach-rdv account disable|enable|delete <email>
#   docker compose exec rdv /oblireach-rdv account promote|demote <email>
#   docker compose exec rdv /oblireach-rdv account reset-2fa <email>

# ---- Abuse reports (with RDV_ACCOUNTS: stored in the account database) -----
# The person helped can report the operator during the session and for this
# many minutes after its end (the thin client offers it for 10 minutes).
#RDV_REPORT_WINDOW_MINUTES=60
# Auto-protection: an operator ACCOUNT reported by this many distinct
# reporters (by address; IPv6 by /64) within RDV_REPORTS_AUTODISABLE_DAYS is
# disabled pending an admin's review (audit log: "system"). 0 = off.
# Default: 3 on a public instance, 0 on a private one.
#RDV_REPORTS_AUTODISABLE=3
#RDV_REPORTS_AUTODISABLE_DAYS=7
# With SMTP, every address of RDV_ADMIN_EMAILS gets a short email per new
# report (at most 3 per hour per address; the console has them all).
# Reports CLI (inside the container):
#   docker compose exec rdv /oblireach-rdv report list [open|closed|all]
#   docker compose exec rdv /oblireach-rdv report close <id> handled|not_abuse

# ---- Reverse proxy ---------------------------------------------------------
# A) HTTP reverse proxy (nginx terminates TLS): RDV_TLS=off,
#    RDV_LISTEN=127.0.0.1:8085, RDV_TRUST_PROXY=true, RDV_PUBLIC_URL=https://...
#    TURN over TLS on 443 is lost (STUN/TURN on 3478 udp/tcp remain).
#    The proxy MUST set X-Forwarded-For ($proxy_add_x_forwarded_for) and
#    X-Forwarded-Proto; the last X-Forwarded-For entry is the client.
#    nginx (server block for the public name, TLS configured as usual):
#      location / {
#          proxy_pass http://127.0.0.1:8085;
#          proxy_http_version 1.1;
#          proxy_set_header Upgrade $http_upgrade;
#          proxy_set_header Connection $connection_upgrade;  # map $http_upgrade $connection_upgrade { default upgrade; '' close; }
#          proxy_set_header Host $host;
#          proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
#          proxy_set_header X-Forwarded-Proto $scheme;
#          proxy_set_header X-Forwarded-Host $host;
#          proxy_read_timeout 1h;
#          proxy_send_timeout 1h;
#          proxy_buffering off;
#      }
#    Never set RDV_TRUST_PROXY=true when clients can reach RDV_LISTEN directly.
#RDV_TRUST_PROXY=false
#
# B) SNI passthrough (nginx "stream", keeps TURN over TLS on 443): rdv
#    terminates TLS itself (RDV_TLS=acme or files) on a loopback port and
#    nginx forwards the raw TCP stream of its server name with the PROXY
#    protocol, so rdv still sees the real client address:
#      RDV_LISTEN=127.0.0.1:8443  RDV_TURNS_PORT=443  RDV_PROXY_PROTOCOL=true
#    With acme, the TLS-ALPN-01 challenge passes through the stream as well.
#RDV_PROXY_PROTOCOL=false

# ---- Misc ----------------------------------------------------------------
# TURN REST secret. Default: generated once and kept in /data/turn-secret.
#RDV_TURN_SECRET=

# Relay limits.
#RDV_RELAY_MAX_KBPS_SESSION=8000
#RDV_RELAY_MAX_MIN_SESSION=240
#RDV_RELAY_MAX_CONCURRENT=300
# Close relay allocations that relayed nothing for that long (0 = never).
#RDV_RELAY_IDLE_SECONDS=20

# Logs: JSON lines on stdout, no content ever (accounts are logged as
# acct:<id>, never by email). IP rendering: full | truncated | hmac
#RDV_LOG_IP_MODE=full
#RDV_LOG_LEVEL=info

# A host whose signalling drops keeps its ID that long: it reconnects with a
# resume secret (kept in its memory only, stored hashed here) and gets the
# same ID back. 0 = off (a new ID after every drop). IDs locked by wrong
# codes are never resumed. Reservations live in memory: a restart drops them.
#RDV_RESUME_GRACE_SECONDS=600

# Refuse older clients.
#RDV_MIN_CLIENT_VERSION=
